SystemName siesta
SystemLabel tbt
TBT.HS ./Ham_re_big.nc

%block TBT.k
  0. 0. 0.   1.0
%endblock TBT.k

%include ./TBT_Atoms_Device.fdf

TBT.CDF.SelfEnergy.Save
TBT.T.Bulk True
TBT.DOS.Elecs True
TBT.DOS.A.All True
TBT.DOS.GF True

%block TS.Elecs
    Bottom
%endblock TS.Elecs

TBT.Elecs.Eta  0.001 eV
TBT.Contours.Eta 0.001 eV ## Actually matters..

%block TBT.contour.line
    from -4.0 eV to 4.0 eV # write whatever contour, since we will overwrite it with the one we computed
    file contour.IN
%endblock TBT.contour.line

%block Ts.Elec.Bottom
    HS ./Ham_elec_big.nc
    semi-inf-direction abc
    Electrode-position 1
    Out-of-core True
    tbt.gf RSSE.TBTGF
%endblock Ts.Elec.Bottom

